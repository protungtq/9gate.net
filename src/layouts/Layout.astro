---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import games from '../data/games.json';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: object;
}

const { title, description, keywords, ogImage, ogType = 'website', canonical, jsonLd, robots = 'index, follow' } = Astro.props;
const siteName = '9Gate';
const pageUrl = canonical || new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// ===== Mục lục tìm kiếm (game + bài viết) =====
const postEntries = await getCollection('posts');
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));
const searchIndex = [
  ...games.map((g) => ({
    t: g.name,
    s: `${g.genre} · ${g.publisher}`,
    u: `/game/${g.slug}/`,
    i: g.icon || '',
  })),
  ...postEntries.map((p) => ({
    t: p.data.title,
    s: gameBySlug[p.data.game]?.name || 'Bài viết',
    u: `/p/${p.id.replace(/\.(md|mdx)$/i, '')}/`,
    i: p.data.image || gameBySlug[p.data.game]?.icon || '',
  })),
];

// ===== Điều hướng =====
const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: 'Trang chủ', icon: '<path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z"/>' },
  { href: '/mobile/', label: 'Game Mobile', icon: '<rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18h2"/>' },
  { href: '/pc/', label: 'PC / Console', icon: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>' },
  { href: '/cap-nhat/', label: 'Cập nhật mới', icon: '<path d="M6 8a6 6 0 0112 0c0 7 3 8 3 8H3s3-1 3-8M10 21h4"/>' },
];
const detailGame = path.startsWith('/game/') ? gameBySlug[path.split('/')[2]] : undefined;
const activePath = detailGame ? (detailGame.category === 'mobile' ? '/mobile/' : '/pc/') : path;
const isActive = (href: string) =>
  href === '/' ? activePath === '/' : activePath.startsWith(href) || (href === '/cap-nhat/' && path.startsWith('/p/'));
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KFTNF5MR');</script>
  <!-- End Google Tag Manager -->
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8659766351583715"
     crossorigin="anonymous"></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#fb813e" />
  <link rel="canonical" href={pageUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:url" content={pageUrl} />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="icon" type="image/x-icon" sizes="16x16" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Khởi tạo Theme chống nhấp nháy giao diện -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.classList.toggle('dark', t === 'dark');
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', t === 'dark' ? '#191512' : '#fb813e');
    })();
  </script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KFTNF5MR"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <header class="site-header site-chrome sticky top-[env(safe-area-inset-top,0px)] z-50 backdrop-blur shadow-[0_6px_24px_-10px_rgba(0,0,0,.25)] border-b">
    <div class="brand-stripe h-[3px]"></div>
    <div class="max-w-[1280px] mx-auto px-3 sm:px-4 h-16 lg:h-[72px] flex items-center gap-2 lg:gap-4">
      <a href="/" class="brand-link flex shrink-0 items-center rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-tap" aria-label={`${siteName} – Trang chủ`}>
        <img src="/brand/9gate-legacy.png" alt="" width="180" height="62" class="block h-auto w-28 sm:w-32" />
      </a>
      <nav aria-label="Điều hướng chính" class="hidden lg:flex shrink-0 gap-1 text-sm font-semibold">
        {NAV.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined} class={`px-4 h-10 grid place-items-center whitespace-nowrap rounded-full transition ${isActive(n.href) ? 'bg-tap/10 text-tap' : 'hover:bg-black/5 dark:hover:bg-white/10'}`}>{n.label}</a>
        ))}
      </nav>
      <button id="search-toggle" type="button" aria-label="Tìm kiếm" aria-controls="header-search" aria-expanded="false" class="ml-auto grid h-11 w-11 shrink-0 place-items-center rounded-full sf hover:bg-black/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-tap dark:hover:bg-white/15 lg:hidden">
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
      <div id="header-search" role="search" class="hidden absolute inset-x-3 top-full z-20 mt-2 rounded-2xl bg-[var(--gate-panel)] p-2 shadow-lg ring-1 ring-[var(--gate-border)] lg:relative lg:inset-auto lg:mt-0 lg:ml-auto lg:block lg:min-w-0 lg:flex-1 lg:max-w-xl lg:bg-transparent lg:p-0 lg:shadow-none lg:ring-0 lg:dark:bg-transparent">
        <div class="relative">
          <svg aria-hidden="true" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="q" type="search" aria-label="Tìm game hoặc bài viết" placeholder="Tìm game, bài viết…" autocomplete="off" class="w-full h-11 rounded-full bg-[var(--gate-inset)] pl-10 pr-4 text-base lg:text-sm placeholder:text-slate-600 dark:placeholder:text-slate-400 outline-none focus:ring-2 ring-tap" />
          <div id="sr" class="hidden absolute left-0 right-0 top-full mt-2 rounded-2xl bg-[var(--gate-panel)] ring-1 ring-[var(--gate-border)] shadow-xl p-2 max-h-80 overflow-auto z-50"></div>
        </div>
      </div>
      <button id="tg" type="button" aria-label="Chuyển giao diện sáng / tối" title="Sáng / tối" class="w-11 h-11 shrink-0 rounded-full sf grid place-items-center hover:bg-black/10 dark:hover:bg-white/15 transition">
        <svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>
      <details id="header-menu" class="relative shrink-0 lg:hidden">
        <summary aria-label="Menu điều hướng" class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full sf hover:bg-black/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-tap dark:hover:bg-white/15 [&::-webkit-details-marker]:hidden">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>
        <nav aria-label="Điều hướng trên màn hình nhỏ" class="absolute right-0 top-full z-30 mt-2 w-56 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-[var(--gate-border)] bg-[var(--gate-panel)] p-1.5 shadow-xl">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined} class={`flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-tap ${isActive(n.href) ? 'bg-tap/10 text-tap' : 'hover:bg-black/5 dark:hover:bg-white/10'}`}>
              <svg aria-hidden="true" class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon}></svg>
              {n.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <nav id="mobile-nav" aria-label="Điều hướng trên thiết bị di động" class="mobile-nav site-chrome fixed inset-x-0 bottom-0 z-50 grid grid-cols-4 border-t backdrop-blur lg:hidden">
    {NAV.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class:list={['mobile-nav-item flex flex-col items-center justify-center gap-1 px-1 text-center text-[11px] font-semibold leading-tight focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-tap', active ? 'text-tap' : 'muted']}
        >
          <svg aria-hidden="true" class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
          {item.href === '/cap-nhat/' ? 'Cập nhật' : item.label}
        </a>
      );
    })}
  </nav>

  <footer class="site-footer mt-16 text-slate-300">
    <div class="brand-stripe h-[3px]"></div>
    <div class="max-w-[1280px] mx-auto px-4 py-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-10 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div class="col-span-2 sm:col-span-1">
        <img src="/brand/9gate-legacy.png" alt={siteName} width="180" height="62" loading="lazy" class="block h-auto w-32" />
        <p class="mt-4 text-sm leading-relaxed text-slate-400 max-w-xs">Chia sẻ mọi thứ về game với đam mê và sự tử tế!</p>
      </div>
      <div>
        <h4 class="font-bold text-white mb-3">Khám phá</h4>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-tap" href="/">Trang chủ</a></li>
          <li><a class="hover:text-tap" href="/mobile/">Game Mobile</a></li>
          <li><a class="hover:text-tap" href="/pc/">Game PC / Console</a></li>
          <li><a class="hover:text-tap" href="/cap-nhat/">Cập nhật mới</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-white mb-3">Nền tảng</h4>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-tap" href="/mobile/">Android</a></li>
          <li><a class="hover:text-tap" href="/mobile/">iOS</a></li>
          <li><a class="hover:text-tap" href="/pc/">PC</a></li>
          <li><a class="hover:text-tap" href="/pc/">PlayStation · Xbox · Switch</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="max-w-[1280px] mx-auto px-4 py-5 text-xs text-slate-500 flex flex-wrap justify-between gap-2">
        <span>© 2026 {siteName} - Thế giới GAME của bạn</span>
        <span>Điều khoản · Chính sách bảo mật</span>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ searchIndex }}>
    // ===== Sáng / tối =====
    function setTheme(t) {
      document.documentElement.classList.toggle('dark', t === 'dark');
      try { localStorage.setItem('theme', t); } catch (e) {}
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', t === 'dark' ? '#191512' : '#fb813e');
    }
    var tgBtn = document.getElementById('tg');
    if (tgBtn) tgBtn.addEventListener('click', function () {
      setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
    });

    // ===== Tìm kiếm =====
    var norm = function (s) {
      return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
    };
    var q = document.getElementById('q');
    var sr = document.getElementById('sr');
    function hideSr() { if (sr) sr.classList.add('hidden'); }
    if (q && sr) {
      q.addEventListener('input', function () {
        var v = norm(q.value.trim());
        if (!v) { hideSr(); return; }
        var r = searchIndex.filter(function (x) { return norm(x.t + ' ' + x.s).includes(v); }).slice(0, 8);
        sr.innerHTML = r.length
          ? r.map(function (x) {
              return '<a href="' + x.u + '" class="flex items-center gap-3 p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10">' +
                (x.i ? '<img src="' + x.i + '" alt="" class="w-10 h-10 rounded-[22%] object-cover shrink-0" loading="lazy">' : '<span class="w-10 h-10 rounded-[22%] bg-tap/15 shrink-0"></span>') +
                '<span class="min-w-0"><span class="block font-bold text-sm truncate">' + x.t + '</span>' +
                '<span class="block text-xs muted truncate">' + x.s + '</span></span></a>';
            }).join('')
          : '<div class="p-3 text-sm muted">Không tìm thấy kết quả phù hợp</div>';
        sr.classList.remove('hidden');
      });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !sr.classList.contains('hidden')) {
          var first = sr.querySelector('a');
          if (first) window.location.href = first.getAttribute('href');
        }
      });
    }

    // ===== Điều hướng và tìm kiếm trên màn hình nhỏ =====
    var headerMenu = document.getElementById('header-menu');
    var searchToggle = document.getElementById('search-toggle');
    var headerSearch = document.getElementById('header-search');
    var desktopHeader = window.matchMedia('(min-width: 1024px)');
    function setMobileSearch(open) {
      headerSearch.classList.toggle('hidden', !open);
      searchToggle.setAttribute('aria-expanded', String(open));
      if (open) {
        headerMenu.open = false;
        q.focus();
        if (q.value.trim()) q.dispatchEvent(new Event('input'));
      } else {
        hideSr();
      }
    }
    searchToggle.addEventListener('click', function () {
      setMobileSearch(searchToggle.getAttribute('aria-expanded') !== 'true');
    });
    headerMenu.addEventListener('toggle', function () {
      if (headerMenu.open) setMobileSearch(false);
    });
    desktopHeader.addEventListener('change', function () {
      headerMenu.open = false;
      setMobileSearch(false);
    });
    document.addEventListener('click', function (e) {
      if (!headerMenu.contains(e.target)) headerMenu.open = false;
      if (!headerSearch.contains(e.target) && !searchToggle.contains(e.target)) {
        if (desktopHeader.matches) hideSr();
        else setMobileSearch(false);
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (headerMenu.open) {
        headerMenu.open = false;
        headerMenu.querySelector('summary').focus();
      } else if (searchToggle.getAttribute('aria-expanded') === 'true') {
        setMobileSearch(false);
        searchToggle.focus();
      } else if (!sr.classList.contains('hidden')) {
        hideSr();
        q.focus();
      }
    });
  </script>

  <script is:inline>
    (() => {
      const nav = document.getElementById('mobile-nav');
      const desktop = window.matchMedia('(min-width: 1024px)');
      const tapDistance = 10;
      const swipeDistance = 24;
      let gesture;

      function track(touch) {
        const dx = Math.abs(touch.clientX - gesture.x);
        const dy = touch.clientY - gesture.y;
        if (dx > tapDistance || Math.abs(dy) > tapDistance) gesture.moved = true;
        if (Math.abs(dy) >= swipeDistance && Math.abs(dy) > dx) nav.toggleAttribute('data-hidden', dy < 0);
      }

      window.addEventListener('touchstart', (event) => {
        gesture = undefined;
        if (desktop.matches || event.touches.length !== 1) return;
        const touch = event.touches[0];
        gesture = { id: touch.identifier, x: touch.clientX, y: touch.clientY, started: event.timeStamp, moved: false };
      }, { passive: true });

      window.addEventListener('touchmove', (event) => {
        if (!gesture || event.touches.length !== 1) return;
        const touch = event.touches[0];
        if (touch.identifier === gesture.id) track(touch);
      }, { passive: true });

      window.addEventListener('touchend', (event) => {
        if (!gesture) return;
        const touch = Array.from(event.changedTouches).find(item => item.identifier === gesture.id);
        if (!touch) return;
        track(touch);

        const tapped = !gesture.moved && event.timeStamp - gesture.started < 500;
        gesture = undefined;
        if (tapped) {
          // Let the browser dispatch the tap's click before moving the links.
          window.requestAnimationFrame(() => {
            if (!desktop.matches) nav.toggleAttribute('data-hidden');
          });
        }
      }, { passive: true });

      window.addEventListener('touchcancel', () => { gesture = undefined; }, { passive: true });
      desktop.addEventListener('change', () => {
        gesture = undefined;
        nav.removeAttribute('data-hidden');
      });
      nav.addEventListener('focusin', () => nav.removeAttribute('data-hidden'));
    })();
  </script>
</body>
</html>
