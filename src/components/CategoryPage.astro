---
import Layout from '../layouts/Layout.astro';
import GameCard from './GameCard.astro';
import Pagination from './Pagination.astro';
import { GAME_PAGE_SIZE, type gameCategoryPaths } from '../lib/gameCategory';

type Props = Awaited<ReturnType<typeof gameCategoryPaths>>[number]['props'];

const {
  title, subtitle, seoTitle, description, keywords, games, postImages,
  filters, activeFilter, sorts, activeSort, currentPage, totalPages, previousHref, nextHref,
} = Astro.props;
const genre = filters.find(({ path }) => path === activeFilter)?.label ?? '';
const pageTitle = activeFilter ? `${title} · ${genre}` : seoTitle;
const legacyList = activeFilter.startsWith('khu-vuc/') || activeFilter.startsWith('nen-tang/');
const heading = legacyList ? pageTitle : title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: activeFilter ? pageTitle : title,
  itemListElement: games.map((game, index) => ({
    '@type': 'ListItem',
    position: (currentPage - 1) * GAME_PAGE_SIZE + index + 1,
    name: game.name,
    url: new URL(`/game/${game.slug}/`, Astro.site ?? Astro.url).href,
  })),
};
---

<Layout
  title={currentPage > 1 ? `${pageTitle} · Trang ${currentPage}` : pageTitle}
  description={legacyList ? `Danh sách game ${genre} trên 9Gate, gồm thông tin game và các bài viết liên quan.` : description}
  keywords={keywords}
  jsonLd={jsonLd}
  robots={activeSort ? 'noindex, follow' : undefined}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold">{heading}</h1>
        <p class="muted mt-1">{subtitle}</p>
      </div>
      <nav class="flex rounded-full sf p-1 text-sm font-semibold" aria-label="Sắp xếp game">
        {sorts.map(({ path, label, href }) => (
          <a
            href={href}
            aria-current={path === activeSort ? 'true' : undefined}
            class:list={['inline-flex items-center px-4 h-8 rounded-full transition', path === activeSort ? 'bg-white dark:bg-white/20 shadow-sm' : 'muted']}
          >{label}</a>
        ))}
      </nav>
    </div>

    <nav class="hs flex gap-2 mt-5 mb-7" aria-label="Thể loại game">
      {filters.map(({ path, label, href }) => (
        <a
          href={href}
          aria-current={path === activeFilter ? 'true' : undefined}
          class:list={['chip shrink-0', { 'chip-on': path === activeFilter }]}
        >{label}</a>
      ))}
    </nav>

    {games.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8" id="cat-grid">
        {games.map((game) => <GameCard game={game} postImg={postImages[game.slug]} />)}
      </div>
    ) : (
      <p class="text-center muted py-16 font-medium">Chưa có game nào thuộc thể loại này.</p>
    )}

    <Pagination label="Phân trang game" {...{ currentPage, totalPages, previousHref, nextHref }} />
  </div>
</Layout>
