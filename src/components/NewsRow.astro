---
import { gameImage } from '../lib/gameArt';

const { post, game, postImg } = Astro.props;
const tagText = post.tag || 'Bài viết';
const thumb = post.image || gameImage(game, postImg);
---

<a
  href={`/p/${post.slug}/`}
  class="news-row flex min-w-0 gap-3 px-1 py-3 transition fade"
  data-tags={(post.tags || []).join('|').toLowerCase()}
>
  <div class="news-thumb relative aspect-video w-32 max-w-[36%] shrink-0 self-start overflow-hidden rounded-sm bg-gradient-to-br from-slate-600 to-slate-900">
    {thumb ? (
      <img src={thumb} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-center" />
    ) : (
      <span aria-hidden="true" class="absolute inset-0 grid place-items-center text-3xl font-black text-white/40">{(post.title || 'G').charAt(0)}</span>
    )}
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-between gap-2">
    <h3 class="line-clamp-3 break-words text-sm font-semibold leading-snug sm:text-base">{post.title}</h3>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs">
      {post.dateText && <span class="muted">{post.dateText}</span>}
      {post.dateText && <span class="muted" aria-hidden="true">|</span>}
      <span class="text-tap">{tagText}</span>
    </div>
  </div>
</a>
