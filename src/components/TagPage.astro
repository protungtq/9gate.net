---
import Layout from '../layouts/Layout.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import NewsRow from './NewsRow.astro';
import Pagination from './Pagination.astro';
import games from '../data/games.json';
import { POST_PAGE_SIZE, type TagGroup, type TagPost } from '../lib/tags';
import { breadcrumbSchema, listSchema, seoSummary } from '../lib/seo';
import { gameImage } from '../lib/gameArt';

type TagLink = Pick<TagGroup, 'slug' | 'label'>;

interface Props {
  tagLabel: string;
  totalPosts: number;
  posts: TagPost[];
  navTags: TagLink[];
  recentTags: TagLink[];
  postImageMap: Record<string, string>;
  currentPage: number;
  totalPages: number;
  previousHref?: string;
  nextHref?: string;
}

const {
  tagLabel, totalPosts, posts, navTags, recentTags, postImageMap,
  currentPage, totalPages, previousHref, nextHref,
} = Astro.props;
const gameBySlug = Object.fromEntries(games.map((game) => [game.slug, game]));
const slug = Astro.params.tag;
const site = Astro.site ?? Astro.url;
const paginated = currentPage > 1;
const crumbs = [
  { name: 'Cập nhật mới', path: '/cap-nhat/' },
  { name: 'Chủ đề bài viết', path: '/tags/' },
  { name: tagLabel, path: `/tags/${slug}/` },
];
if (paginated) crumbs.push({ name: `Trang ${currentPage}`, path: Astro.url.pathname });
const jsonLd = [
  breadcrumbSchema(site, crumbs),
  listSchema(site, tagLabel, posts.map((post) => ({ name: post.title, path: `/p/${post.slug}/` })), (currentPage - 1) * POST_PAGE_SIZE),
];
const description = seoSummary(`${tagLabel} trên 9Gate · ${totalPosts} bài viết.${paginated ? ` Trang ${currentPage}.` : ''}${posts[0] ? ` ${posts[0].title}` : ''}`);
const first = posts[0];
const ogImage = first ? first.image || gameImage(gameBySlug[first.gameSlug], postImageMap[first.gameSlug]) : undefined;
---

<Layout
  title={`Chủ đề: ${tagLabel}${paginated ? ` · Trang ${currentPage}` : ''}`}
  description={description}
  ogImage={ogImage}
  keywords={`${tagLabel}, 9gate, game`}
  jsonLd={jsonLd}
>
  <div class="content-grid py-6">
    <section class="post-panel min-w-0 p-4 sm:p-6" aria-labelledby="tag-heading">
      <span class="text-[11px] font-bold uppercase tracking-wider muted block mb-1">Chủ đề bài viết</span>
      <h1 id="tag-heading" class="break-words text-3xl sm:text-4xl font-extrabold">
        <span class="text-tap">#</span>{tagLabel}
        {paginated && <span class="text-base font-normal muted"> (Trang {currentPage})</span>}
      </h1>
      <p class="muted mt-1">{totalPosts} bài viết</p>

      <nav class="tag-topics flex gap-2 overflow-x-auto p-1 pb-2 my-4" aria-label="Chủ đề bài viết">
        <a class="chip shrink-0" href="/tags/">Tất cả chủ đề</a>
        {navTags.map((tag) => (
          <a
            class:list={['chip shrink-0', { 'chip-on': tag.slug === slug }]}
            aria-current={tag.slug === slug ? 'true' : undefined}
            href={`/tags/${tag.slug}/`}
          >{tag.label}</a>
        ))}
      </nav>

      {posts.length > 0 ? (
        <div class:list={['grid gap-x-4', posts.length > 1 && 'xl:grid-cols-2']}>
          {posts.map((post) => <NewsRow post={post} game={gameBySlug[post.gameSlug]} postImg={postImageMap[post.gameSlug]} />)}
        </div>
      ) : (
        <p class="muted py-12 text-center">Mình chưa có bài nào ở đây.</p>
      )}

      <Pagination label="Phân trang bài viết" {...{ currentPage, totalPages, previousHref, nextHref }} />
    </section>

    <ArticleSidebar gameLimit={5} stackOnMobile>
      <section class="post-panel px-4 py-5 xl:px-5" aria-labelledby="recent-tags-heading">
        <h2 id="recent-tags-heading" class="section-title mb-3">Tag nổi bật</h2>
        <ul class="tag-cloud">
          {recentTags.map((tag) => (
            <li>
              <a
                class="tag-cloud-link"
                aria-current={tag.slug === slug ? 'true' : undefined}
                href={`/tags/${tag.slug}/`}
              >{tag.label}</a>
            </li>
          ))}
        </ul>
      </section>
    </ArticleSidebar>
  </div>
</Layout>

<style>
  .tag-topics {
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--gate-accent) / 0.45) transparent;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .tag-cloud > li {
    min-inline-size: 0;
    max-inline-size: calc((100% - 0.375rem) / 2);
  }

  .tag-cloud-link {
    display: block;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--gate-border);
    border-radius: 1rem;
    background: var(--gate-inset);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .tag-cloud-link:is(:hover, :focus-visible) {
    border-color: rgb(var(--gate-accent));
    color: rgb(var(--gate-accent));
  }

  .tag-cloud-link[aria-current] {
    border-color: var(--gate-action);
    background: var(--gate-action);
    color: white;
  }
</style>
