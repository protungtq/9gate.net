<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>9Gate CMS</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f6f8;--sf:#fff;--ln:#e4e7ec;--tx:#15171a;--mu:#667085;--ac:#16c79a;--ad:#0e9f7b;--dn:#e5484d;--wn:#b7791f;--in:#f1f3f5;color-scheme:light}
html[data-t=dark]{--bg:#0e1013;--sf:#16191e;--ln:#262a31;--tx:#eceef1;--mu:#9aa3af;--in:#1d2127;--wn:#f0b429;color-scheme:dark}
*{box-sizing:border-box}body{margin:0;font:14px/1.5 "Be Vietnam Pro",system-ui,sans-serif;background:var(--bg);color:var(--tx)}
button,input,select,textarea{font:inherit;color:inherit}
.app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}
aside{position:sticky;top:0;height:100vh;padding:20px 14px;border-right:1px solid var(--ln);background:var(--sf);display:flex;flex-direction:column;gap:4px}
.logo{font-weight:800;font-size:19px;padding:4px 10px 18px}.logo b{color:var(--ac)}.logo small{display:block;font-size:12px;font-weight:500;color:var(--mu)}
.nav{display:flex;justify-content:space-between;align-items:center;border:0;background:none;padding:10px 12px;border-radius:10px;cursor:pointer;font-weight:600;color:var(--mu);text-align:left}
.nav:hover{background:var(--in)}.nav.on{background:var(--ac);color:#fff}.nav i{font-style:normal;font-size:12px;opacity:.8}
.sp{flex:1}
main{padding:28px clamp(16px,3vw,40px) 110px;max-width:1180px;width:100%;min-width:0}
h1{font-size:26px;margin:0 0 4px;font-weight:800}.sub{color:var(--mu);margin:0 0 20px}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
input,select,textarea{width:100%;background:var(--sf);border:1px solid var(--ln);border-radius:10px;padding:10px 12px}
input:focus,select:focus,textarea:focus{outline:2px solid var(--ac);outline-offset:-1px}
textarea{min-height:90px;resize:vertical}
.bar input:not([type=file]){flex:1;min-width:0;flex-basis:240px}.bar select{width:auto}
.btn{border:0;border-radius:10px;padding:10px 16px;font-weight:700;cursor:pointer;background:var(--in);white-space:nowrap}
.btn:hover{filter:brightness(.95)}.p{background:var(--ac);color:#fff}.d{color:var(--dn)}.btn:focus-visible,.nav:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.chip{border:1px solid var(--ln);background:var(--sf);border-radius:99px;padding:5px 14px;cursor:pointer;font-weight:600;font-size:13px}.chip.on{background:var(--tx);color:var(--bg);border-color:var(--tx)}
.list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:12px}
.gi{display:flex;gap:12px;align-items:center;background:var(--sf);border:1px solid var(--ln);border-radius:14px;padding:12px}
.ic{width:56px;height:56px;border-radius:14px;object-fit:cover;flex:none;background:linear-gradient(135deg,var(--ac),#3b82f6);color:#fff;display:grid;place-items:center;font-weight:800;font-size:22px;overflow:hidden}
.gi .t{flex:1;min-width:0}.gi h3{margin:0;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gi p{margin:0;font-size:12px;color:var(--mu);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tg{display:inline-block;font-size:11px;font-weight:600;border-radius:6px;padding:1px 7px;margin:4px 4px 0 0;background:var(--in);color:var(--mu)}.tg.w{color:var(--wn)}.tg.g{color:var(--ad)}
.rt{font-weight:800;color:var(--ad);font-size:18px;text-align:center;min-width:36px}.rt small{display:block;font-size:10px;color:var(--mu);font-weight:500}
.ac{display:flex;flex-direction:column;gap:4px}.ac button{border:1px solid var(--ln);background:none;border-radius:8px;padding:3px 10px;cursor:pointer;font-size:12px}
.card{background:var(--sf);border:1px solid var(--ln);border-radius:16px;padding:22px;margin-bottom:16px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.g3{display:grid;grid-template-columns:2fr 2fr 1fr;gap:14px}
.f{margin-bottom:14px}.f>label{display:block;font-weight:600;margin-bottom:5px;font-size:13px}.hint{font-size:12px;color:var(--mu);margin-top:4px}
.pv{max-height:90px;border-radius:8px;margin-top:8px;display:none}
.chk{display:flex;gap:18px;flex-wrap:wrap}.chk label{display:flex;gap:8px;align-items:center;font-weight:500}.chk input{width:auto}
details{border:1px solid var(--ln);border-radius:12px;padding:12px 14px;margin-bottom:14px}summary{cursor:pointer;font-weight:600}
.tb{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}.tb button{padding:5px 11px;border-radius:8px;border:1px solid var(--ln);background:var(--sf);cursor:pointer;font-weight:700}
#body{min-height:360px;font:13px/1.65 ui-monospace,Menlo,Consolas,monospace}
.prev{min-height:360px;border:1px solid var(--ln);border-radius:10px;padding:14px 18px;background:var(--sf);overflow-wrap:anywhere}#raw-preview{white-space:pre-wrap}.text-btn{border:0;background:none;color:var(--ad);padding:5px 0;cursor:pointer;text-decoration:underline}.btn:disabled{opacity:.55;cursor:wait}.g2>*,.g3>*{min-width:0}.prev img{max-width:100%;border-radius:10px}.prev h2{font-size:20px}
.fix{position:fixed;left:230px;right:0;bottom:0;padding:12px clamp(16px,3vw,40px);background:var(--sf);border-top:1px solid var(--ln);display:flex;gap:10px;align-items:center;z-index:5}
.fix span{flex:1;color:var(--mu)}.fix.dirty span{color:var(--wn);font-weight:600}
#toast{position:fixed;top:16px;right:16px;z-index:9;display:flex;flex-direction:column;gap:8px}
.ts{background:var(--tx);color:var(--bg);border-radius:10px;padding:11px 16px;font-weight:600;max-width:360px;box-shadow:0 8px 24px rgba(0,0,0,.2)}.ts.e{background:var(--dn);color:#fff}.ts.o{background:var(--ac);color:#fff}
.empty{padding:40px;text-align:center;color:var(--mu);border:1px dashed var(--ln);border-radius:14px}
.v{display:none}.v.on{display:block}
@media(max-width:820px){.app{display:block}aside{position:static;height:auto;flex-direction:row;flex-wrap:wrap;padding:10px;border-right:0;border-bottom:1px solid var(--ln)}.logo{padding:6px 10px;width:100%}.sp{display:none}.fix{left:0}.g2,.g3{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="logo">9<b>Gate</b> CMS<small>Quản lý game và bài viết</small></div>
  <button class="nav on" data-v="games">Game <i id="nG">0</i></button>
  <button class="nav" data-v="posts">Bài viết</button>
  <button class="nav" data-v="conn">Kết nối</button>
  <div class="sp"></div>
  <button class="nav" id="theme" aria-label="Đổi giao diện sáng hoặc tối">Giao diện sáng / tối</button>
</aside>
<main>
<!-- GAMES -->
<section class="v on" id="v-games">
  <div id="gl">
    <h1>Game</h1><p class="sub">Dữ liệu lưu trong <code>src/data/games.json</code>. Sửa xong bấm "Đẩy lên GitHub" ở thanh dưới để trang tự build lại.</p>
    <div class="bar"><input id="q" placeholder="Tìm theo tên game hoặc nhà phát hành"><select id="fc"><option value="">Mọi danh mục</option><option value="mobile">Game Mobile</option><option value="pc-console">Game PC / Console</option></select><button class="btn p" id="add">Thêm game</button></div>
    <div class="chips" id="chips"></div>
    <div class="list" id="list"></div>
  </div>
  <div id="gf" style="display:none">
    <h1 id="ft">Thêm game mới</h1><p class="sub">Các ô có dấu * là bắt buộc. Để trống phần SEO thì hệ thống tự tạo.</p>
    <div class="card">
      <div class="g2"><div class="f"><label>Tên game *</label><input id="name"></div><div class="f"><label>Slug *</label><input id="slug"><div class="hint">Là đường dẫn trang game. Không đổi được sau khi đã lưu.</div></div></div>
      <div class="g2"><div class="f"><label>Nhà phát hành</label><input id="publisher"></div><div class="f"><label>Thể loại</label><input id="genre"></div></div>
      <div class="g2"><div class="f"><label>Danh mục *</label><select id="category"><option value="mobile">Game Mobile</option><option value="pc-console">Game PC / Console</option></select></div><div class="f"><label>Nền tảng</label><input id="platforms" placeholder="Mobile hoặc PC, PS5, Xbox"><div class="hint">Cách nhau bằng dấu phẩy.</div></div></div>
      <div class="g2"><div class="f"><label>Icon (URL)</label><input id="icon" data-pv="pi"><img id="pi" class="pv" alt=""></div><div class="f"><label>Ảnh bìa (URL)</label><input id="cover" data-pv="pc"><img id="pc" class="pv" alt=""></div></div>
      <div class="g2"><div class="f"><label>Trailer YouTube</label><input id="trailer" placeholder="https://www.youtube.com/watch?v=..."></div><div class="f"><label>Website hoặc fanpage</label><input id="website"></div></div>
      <div class="g2"><div class="f"><label>Link tải Android</label><input id="android" placeholder="https://play.google.com/store/apps/details?id=..."></div><div class="f"><label>Link tải iOS</label><input id="ios" placeholder="https://apps.apple.com/app/..."></div></div>
      <div class="f"><label>Mô tả</label><textarea id="description"></textarea></div>
      <div class="g2"><div class="f"><label>Điểm đánh giá (0 – 10)</label><input id="rating" type="number" min="0" max="10" step="0.1"><div class="hint">Nhập tay. Hiển thị ở thẻ game và trang chi tiết.</div></div>
      <div class="f"><label>Hiển thị trên trang chủ</label><div class="chk"><label><input type="checkbox" id="featured">Game nổi bật</label><label><input type="checkbox" id="hot">Game hot</label></div></div></div>
      <details><summary>SEO</summary><div style="margin-top:12px"><div class="f"><label>SEO title</label><input id="seoTitle"></div><div class="f"><label>SEO description</label><textarea id="seoDescription" style="min-height:60px"></textarea></div><div class="f"><label>SEO keywords</label><input id="seoKeywords"></div></div></details>
      <div class="bar" style="margin:0"><button class="btn p" id="save">Lưu game</button><button class="btn" id="back">Quay lại danh sách</button></div>
    </div>
  </div>
</section>

<!-- POSTS -->
<section class="v" id="v-posts">
  <h1>Bài viết cập nhật</h1><p class="sub">Mỗi bài là một file Markdown trong <code>src/content/posts/</code>.</p>
  <div class="card" style="padding:14px"><div class="bar" style="margin:0"><input id="lp" placeholder="Dán link bài hoặc nhập slug để mở bài đã đăng"><button class="btn" id="lo">Mở bài</button><button class="btn d" id="ld">Xóa bài</button><button class="btn" id="ln">Bài mới</button><button class="btn" id="import-post">Nhập .md</button><input type="file" id="post-file" accept=".md,.markdown,text/markdown" hidden></div></div>
  <div class="card">
    <div class="g3"><div class="f"><label for="ptitle">Tiêu đề *</label><input id="ptitle"></div><div class="f"><label for="pslug">Slug</label><input id="pslug"><button class="text-btn" id="reset-slug" type="button">Tạo lại từ tiêu đề</button></div><div class="f"><label>Ngày xuất bản (giờ Việt Nam)</label><input id="pdate" type="datetime-local"></div></div>
    <div class="g3"><div class="f"><label>Game liên quan</label><select id="pgame"></select><p class="hint" id="game-link"></p></div><div class="f"><label>Loại bài</label><select id="ptype"><option>Cập nhật</option><option>Hướng dẫn</option><option>Sự kiện</option></select></div><div class="f"><label>Ngày cập nhật (giờ Việt Nam)</label><input id="pupd" type="datetime-local"></div></div>
    <div class="f"><label>Mô tả ngắn</label><textarea id="pdesc" style="min-height:64px"></textarea></div>
    <div class="g2"><div class="f"><label>Ảnh đại diện (URL)</label><input id="pimage" data-pv="ppi"><img id="ppi" class="pv" alt=""></div><div class="f"><label>Thẻ</label><input id="ptags" placeholder="Cách nhau bằng dấu phẩy"></div></div>
    <details><summary>Tác giả và nguồn</summary><div class="g3" style="margin-top:12px"><div class="f"><label>Tác giả</label><input id="pauthor"></div><div class="f"><label>Tên nguồn</label><input id="psn"></div><div class="f"><label>URL nguồn</label><input id="psu"></div></div></details>
    <div class="f"><label for="body">Nội dung (Markdown)</label>
      <div class="tb"><button data-w="**|**">B</button><button data-w="*|*"><i>I</i></button><button data-w="\n## |">H2</button><button data-w="\n- |">Danh sách</button><button data-w="[|](https://)">Liên kết</button><button data-w="![mô tả](|)">Ảnh</button><button id="tp" style="margin-left:auto" aria-pressed="false">Xem trước</button><button id="raw-md" aria-pressed="false">Mã Markdown</button></div>
      <textarea id="body"></textarea><div class="prev" id="prev" hidden></div><pre class="prev" id="raw-preview" hidden></pre><p class="hint" id="draft-status" role="status"></p></div>
    <div class="chk" style="margin-bottom:16px"><label><input type="checkbox" id="pgi" checked>Báo Google index sau khi đăng</label></div>
    <div class="bar" style="margin:0"><button class="btn p" id="ppush">Đăng lên GitHub</button><button class="btn" id="pmd">Tải file .md</button></div>
  </div>
</section>

<!-- CONNECT -->
<section class="v" id="v-conn">
  <h1>Kết nối</h1><p class="sub">Lưu trên trình duyệt này. Worker dùng Cloudflare Access, nên cần đăng nhập trước.</p>
  <div class="card">
    <div class="f"><label>Worker proxy URL</label><input id="cw"></div>
    <div class="g2"><div class="f"><label>GitHub repo (owner/repo)</label><input id="cr"></div><div class="f"><label>Nhánh</label><input id="cb"></div></div>
    <div class="f"><label>Địa chỉ website</label><input id="cs" placeholder="https://www.9gate.net"></div>
    <div class="f"><label>Nơi đọc games.json</label><input id="cj" placeholder="/tools/games-data.json"><div class="hint">Nếu không tải được, CMS đọc từ GitHub raw. Bạn cũng có thể nhập file ở danh sách game.</div></div>
    <button class="btn p" id="cok">Lưu kết nối</button>
  </div>
</section>
</main>
</div>
<div class="fix" id="fix"><span id="fs"></span><button class="btn" id="imp">Nhập games.json</button><button class="btn" id="exp">Tải games.json</button><button class="btn p" id="push">Đẩy lên GitHub</button><input type="file" id="file" accept=".json" hidden></div>
<div id="toast"></div>

<script src="../../tools/gamehub-cms.js"></script>
</body>
</html>
