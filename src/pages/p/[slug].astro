---
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import { getCollection, render } from 'astro:content';
import games from '../../data/games.json';
import { gameImage, latestPostImageMap } from '../../lib/gameArt';
import { tagSlug } from '../../lib/tags';
import { absoluteImage, seoSummary } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title ?? 'Bài viết';
const description = seoSummary(post.data.description?.trim() || title);
const image = post.data.image ?? '';
const tags: string[] = post.data.tags || [];
const tagText = tags[0] || 'Bài viết';
const publicationDate = post.data.date ? new Date(post.data.date) : undefined;
const published = publicationDate && Number.isFinite(publicationDate.valueOf())
  ? publicationDate.toISOString().slice(0, 10)
  : undefined;
const dateText = published ? publicationDate!.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }) : '';
const originalAuthor = (post.data.legacyAuthor || '').trim();
const authorName = originalAuthor || '9Gate';
const editorialTeam = !originalAuthor || /^(9gate|bqt 9gate|admin|administrator)$/i.test(originalAuthor);
const game = games.find((g) => g.slug === post.data.game);
const shareImage = absoluteImage(image || gameImage(game), Astro.site ?? Astro.url);
const BADGES = ['bg-cyan-500', 'bg-violet-500', 'bg-rose-500', 'bg-amber-500', 'bg-emerald-500'];
let hash = 0;
for (const ch of tagText) hash += ch.charCodeAt(0);
const badge = BADGES[hash % BADGES.length];

// Bài khác: ưu tiên cùng game, thiếu thì lấy bài mới nhất khác
const fmtDate = (d: any) =>
  d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));
const selfSlug = post.id.replace(/\.(md|mdx)$/i, '');
const allPosts = (await getCollection('posts'))
  .filter((p) => p.id.replace(/\.(md|mdx)$/i, '') !== selfSlug)
  .map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title,
    description: p.data.description || '',
    image: p.data.image || '',
    tag: (p.data.tags && p.data.tags[0]) || 'Bài viết',
    tags: p.data.tags || [],
    dateText: fmtDate(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }))
  .sort((a, b) => b._ts - a._ts);
const postImageMap = latestPostImageMap([
  ...allPosts,
  { gameSlug: post.data.game || '', image: image, _ts: post.data.date ? new Date(post.data.date).getTime() : 0 },
]);
const sameGame = allPosts.filter((p) => game && p.gameSlug === game.slug);
const morePosts = (sameGame.length > 0 ? sameGame : allPosts).slice(0, 3);
const moreTitle = 'Liên quan';
const sidebarPosts = allPosts.slice(0, 4).map((p) => ({
  t: p.title,
  s: gameBySlug[p.gameSlug]?.name || p.tag,
  u: `/p/${p.slug}/`,
  i: p.image || gameBySlug[p.gameSlug]?.icon || '',
}));

const site = Astro.site ?? Astro.url;
const articleUrl = new URL(Astro.url.pathname, site).href;
const homeUrl = new URL('/', site).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    ...(published && { "datePublished": published }),
    "inLanguage": "vi-VN",
    "mainEntityOfPage": articleUrl,
    ...(shareImage && { "image": shareImage }),
    "author": editorialTeam
      ? { "@type": "Organization", "name": authorName, "url": homeUrl }
      : { "@type": "Person", "name": authorName },
    "publisher": {
      "@type": "Organization",
      "name": "9Gate",
      "url": homeUrl,
      "logo": new URL('/brand/9gate-legacy.png', site).href,
    },
    ...(game && { "about": { "@type": "VideoGame", "name": game.name, "url": new URL(`/game/${game.slug}/`, site).href } }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": homeUrl },
      { "@type": "ListItem", "position": 2, "name": game?.name || "Cập nhật mới",
        "item": new URL(game ? `/game/${game.slug}/` : '/cap-nhat/', site).href },
      { "@type": "ListItem", "position": 3, "name": title, "item": articleUrl },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  ogImage={shareImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="py-6 sm:py-8">
    <div class="text-sm muted mb-5 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-tap">Trang chủ</a><span>›</span>
      {game ? (
        <>
          <a href={`/game/${game.slug}/`} class="hover:text-tap">{game.name}</a><span>›</span>
        </>
      ) : (
        <>
          <a href="/cap-nhat/" class="hover:text-tap">Cập nhật mới</a><span>›</span>
        </>
      )}
      <span class="font-semibold text-[#15171a] dark:text-white">{tagText}</span>
    </div>

    <div class="content-grid">
      <div class="min-w-0">
        <article class="post-panel p-4 sm:p-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class={`text-[11px] font-bold text-white rounded px-1.5 py-0.5 ${badge}`}>{tagText}</span>
            {published && <time class="text-sm muted" datetime={published}>{dateText}</time>}
            <span class="text-sm muted">· {authorName}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mt-3">{title}</h1>

          {game && (
            <a href={`/game/${game.slug}/`} class="rounded-xl border border-[var(--gate-border)] dark:border-slate-700 bg-[var(--gate-inset)] dark:bg-slate-800/60 p-3 flex items-center gap-3 mt-5 hover:border-tap focus-visible:border-tap transition-colors">
              {game.icon ? (
                <img src={game.icon} alt={game.name} class="w-11 h-11 rounded-[22.5%] object-cover ring-1 ring-black/10 shrink-0" />
              ) : (
                <span class="w-11 h-11 rounded-[22.5%] bg-gradient-to-br from-tap to-cyan-500 grid place-items-center text-white font-black shrink-0">{game.name.charAt(0)}</span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block font-bold text-sm truncate">{game.name}</span>
                <span class="block text-xs muted">{game.genre} · {(game.platforms || []).join(' · ')}</span>
              </span>
              <span class="btn btn-o !h-8 !px-4 text-xs shrink-0">Xem game</span>
            </a>
          )}

          {image && <img src={image} alt={title} class="mt-6 w-full rounded-2xl" fetchpriority="high" />}

          <div class="article-body mt-7 flow-root">
            <Content />
          </div>

          {tags.length > 0 && (
            <ul class="flex flex-wrap gap-2 mt-6 border-t border-[var(--gate-border)] dark:border-slate-700 pt-4" aria-label="Chủ đề bài viết">
              {tags.map((t) => (
                <li class="text-xs font-medium rounded-full border border-[var(--gate-border)] dark:border-slate-600 bg-[var(--gate-inset)] dark:bg-slate-800 px-3 py-1">
                  <a href={`/tags/${tagSlug(t)}/`} class="hover:text-tap">{t}</a>
                </li>
              ))}
            </ul>
          )}
        </article>

        {morePosts.length > 0 && (
          <section class="post-panel post-related mt-6 sm:mt-8 p-4 sm:p-6" aria-labelledby="related-heading">
            <h2 id="related-heading" class="section-title text-xl mb-4">{moreTitle}</h2>
            <div class="grid">
              {morePosts.map((p) => <NewsRow post={p} game={gameBySlug[p.gameSlug]} postImg={postImageMap[p.gameSlug]} />)}
            </div>
          </section>
        )}
      </div>
      <div class="article-rail hidden min-w-0 lg:block">
        <ArticleSidebar posts={sidebarPosts} currentGame={game?.slug} />
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1024px) {
    .article-rail {
      /* The desktop header is 72px tall, plus its stripe and border. */
      --rail-top: calc(76px + 0.5rem + env(safe-area-inset-top, 0px));
      --rail-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
      position: sticky;
      top: var(--rail-top);
      max-height: calc(100vh - var(--rail-top) - var(--rail-bottom));
      max-height: calc(100dvh - var(--rail-top) - var(--rail-bottom));
      margin: -0.5rem;
      padding: 0.5rem;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgb(var(--gate-accent) / 0.4) transparent;
    }
  }
</style>
