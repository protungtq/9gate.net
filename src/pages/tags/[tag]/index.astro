---
import TagPage from '../../../components/TagPage.astro';
import { getCollection } from 'astro:content';
import { latestPostImageMap } from '../../../lib/gameArt';
import { mapPost, sortPosts, groupPostsByTag, featuredGroups, recentTagLinks, POST_PAGE_SIZE } from '../../../lib/tags';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  const posts = sortPosts(entries.map(({ id, data }) => mapPost(id, data)));
  const postImageMap = latestPostImageMap(posts);
  const groups = groupPostsByTag(posts);
  const navTags = featuredGroups(groups);
  const recentTags = recentTagLinks(groups);

  return groups.map((group) => {
    const totalPages = Math.max(1, Math.ceil(group.posts.length / POST_PAGE_SIZE));
    return {
      params: { tag: group.slug },
      props: {
        tagLabel: group.label,
        totalPosts: group.posts.length,
        navTags,
        recentTags,
        posts: group.posts.slice(0, POST_PAGE_SIZE),
        postImageMap,
        currentPage: 1,
        totalPages,
        nextHref: totalPages > 1 ? `/tags/${group.slug}/2/` : undefined,
      },
    };
  });
}
---

<TagPage {...Astro.props} />
