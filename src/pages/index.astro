---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import NewsRow from '../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../data/games.json';
import { featureWindow, featuredRank, selectFeatured } from '../lib/featured.js';
import { gameArt, gameImage, latestPostImageMap } from '../lib/gameArt';
import { compareGameRecency } from '../lib/gameRecency';

// ===== Bài viết mới nhất =====
const fmtDate = (d: any) =>
  d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));
const allPostVMs = (await getCollection('posts'))
  .map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title,
    description: p.data.description || '',
    image: p.data.image || '',
    tag: (p.data.tags && p.data.tags[0]) || 'Bài viết',
    tags: p.data.tags || [],
    dateText: fmtDate(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }))
  .sort((a, b) => b._ts - a._ts);
const latestPosts = allPostVMs.slice(0, 6);
const postImageMap = latestPostImageMap(allPostVMs);

const now = Date.now();
const latestPostTs = new Map<string, number>();
for (const post of allPostVMs) {
  if (post.gameSlug && post._ts > 0 && post._ts <= now && !latestPostTs.has(post.gameSlug)) {
    latestPostTs.set(post.gameSlug, post._ts);
  }
}

// ===== Game mới nhất: mục Game Mobile / PC trên trang chủ xếp theo độ mới =====
const nameOrder = new Intl.Collator('vi', { sensitivity: 'base' });
const indexedGames = [...games].sort((a, b) => compareGameRecency(a, b, latestPostTs, nameOrder));
const mobileGames = indexedGames.filter((game) => game.category === 'mobile');
const pcGames = indexedGames.filter((game) => game.category === 'pc-console' || game.category === 'pc');
const heroArt = (game: typeof games[number]) => postImageMap[game.slug] || gameImage(game);
const eligible = games.map((game) => ({
  game, postAt: latestPostTs.get(game.slug) || 0, ...featureWindow(game),
}));
const articleCandidates = eligible.filter(({ postAt }) => postAt > 0)
  .sort((a, b) => b.postAt - a.postAt).slice(0, 6);
const candidates = eligible.filter((item) => item.ends > now || articleCandidates.includes(item))
  .sort((a, b) => featuredRank(b, now) - featuredRank(a, now));
const featured = selectFeatured(candidates, now);
const activeSlug = featured[0]?.game.slug;
const shownSlugs = new Set(featured.map(({ game }) => game.slug));

// Dữ liệu tĩnh cho lần tải đầu. Trình duyệt chọn lại các game theo phiên.
const trendingFallback = [
  games.find((g) => g.slug === 'pubg-mobile') || mobileGames[0],
  games.find((g) => g.slug === 'valorant') || pcGames[0],
  games.find((g) => g.slug === 'genshin-impact') || pcGames[1],
  mobileGames[1],
  pcGames[2],
  mobileGames[2],
].filter(Boolean);
const trending = trendingFallback.slice(0, 4);
const mmorpgSet = games.filter((g) => (g.genre || '').includes('MMORPG') && gameArt(g, postImageMap[g.slug])).slice(0, 4);
const mobileSet = mobileGames.filter((g) => gameArt(g, postImageMap[g.slug])).slice(0, 4);

const site = Astro.site ?? Astro.url;
const siteUrl = new URL('/', site).href;
const siteDescription = '9Gate là blog cá nhân về game Mobile, PC và Console. Khám phá danh mục game, thông tin nền tảng, trailer, link tải và các bài cập nhật mới.';
const publisherId = new URL('/#organization', site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#website', site).href,
    name: '9Gate', url: siteUrl, description: siteDescription, inLanguage: 'vi-VN', publisher: { '@id': publisherId } },
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': publisherId, name: '9Gate',
    url: siteUrl, logo: new URL('/brand/9gate-legacy.png', site).href },
];
---

<Layout
  title="9Gate - Thế giới GAME của bạn"
  description={siteDescription}
  ogImage={featured[0] ? heroArt(featured[0].game) : undefined}
  keywords="blog game cá nhân, game mobile, game PC, console, góc nhìn game"
  jsonLd={jsonLd}
>
  <div class="py-6">

    <h1 class="sr-only">9Gate · Game Mobile, PC và Console</h1>

    <!-- ============ HERO ============ -->
    <div id="hero" hidden={!featured.length} class="game-feature p-2.5 grid lg:grid-cols-[1fr_340px] gap-3">
      <div class="min-w-0">
        <div class="hero-viewport relative aspect-[16/10] sm:aspect-video rounded-2xl overflow-hidden bg-slate-900">
          {candidates.map(({ game, postAt, starts, ends }) => (
            <a
              href={`/game/${game.slug}/`}
              class={`hero-slide absolute inset-0 text-white transition-opacity duration-700 ${game.slug === activeSlug ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
              data-slide={game.slug}
              data-post-at={postAt}
              data-starts={starts}
              data-ends={ends}
              hidden={!shownSlugs.has(game.slug)}
              aria-hidden={game.slug !== activeSlug ? "true" : undefined}
              tabindex={game.slug === activeSlug ? undefined : -1}
            >
              {heroArt(game) && <img src={heroArt(game)} alt={game.name} class="absolute inset-0 w-full h-full object-cover" loading={game.slug === activeSlug ? 'eager' : 'lazy'} fetchpriority={game.slug === activeSlug ? 'high' : undefined} />}
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
                <h2 class="text-2xl sm:text-4xl font-extrabold">{game.name}</h2>
                <p class="mt-1.5 text-sm sm:text-lg font-semibold text-white/90 line-clamp-2 max-w-2xl">{game.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <span class="text-xs font-semibold text-white bg-white/15 backdrop-blur border border-white/25 px-3 py-1.5 rounded-full">{game.genre}</span>
                  <span class="text-xs font-semibold text-white bg-white/15 backdrop-blur border border-white/25 px-3 py-1.5 rounded-full">{game.publisher}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="flex justify-center gap-1.5 mt-3 lg:hidden">
          {candidates.map(({ game }) => (
            <button aria-label={`Hiện ${game.name}`} aria-pressed={game.slug === activeSlug ? 'true' : 'false'} data-dot={game.slug} hidden={!shownSlugs.has(game.slug)} class={`hero-dot h-1.5 rounded-full transition-all ${game.slug === activeSlug ? 'w-6 bg-tap' : 'w-1.5 bg-black/20 dark:bg-white/30'}`}></button>
          ))}
        </div>
      </div>
      <div class="hidden lg:block relative">
        <div class="absolute inset-0 overflow-y-auto fadeb space-y-1 pb-10" style="scrollbar-width:none">
          {candidates.map(({ game }) => (
            <button type="button" aria-pressed={game.slug === activeSlug ? 'true' : 'false'} data-pl={game.slug} hidden={!shownSlugs.has(game.slug)} class={`hero-pl w-full flex items-center gap-3 p-2 rounded-xl text-left transition ${game.slug === activeSlug ? 'bg-tap/10 ring-1 ring-inset ring-tap/35' : 'hover:bg-black/5 dark:hover:bg-white/5'}`}>
              <span class="w-36 aspect-[16/10] rounded-lg overflow-hidden relative shrink-0 block">
                {heroArt(game) && <img src={heroArt(game)} alt={game.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-bold truncate">{game.name}</span>
                <span class="block text-xs muted mt-1 truncate">{game.genre}{(game.rating ?? game.provisionalRating) != null ? ` · ★ ${(game.rating ?? game.provisionalRating)?.toFixed(1)}` : ` · ${game.publisher}`}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ============ THỊNH HÀNH ============ -->
    <section class="content-panel home-section">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-title">Xu hướng</h2>
      </div>
      <div id="trending-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        <GameCard game={trending[0]} postImg={postImageMap[trending[0].slug]} />
        <GameCard game={trending[1]} postImg={postImageMap[trending[1].slug]} />
        <a href="/pc/" data-collection="mmorpg" class="collection-card group block fade">
          <div class="relative aspect-video rounded-2xl overflow-hidden flex ring-1 ring-black/5 dark:ring-white/10">
            {mmorpgSet.map((g) => (
              <div class="flex-1 relative overflow-hidden">
                <img src={gameArt(g, postImageMap[g.slug])} alt={g.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              </div>
            ))}
            <span class="absolute left-2 top-2 text-xs bg-white/90 text-slate-700 rounded-full px-3 py-1 font-medium">Danh sách game</span>
          </div>
          <h3 class="mt-3 text-xl font-extrabold">Tuyển tập MMORPG đáng chơi</h3>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {mmorpgSet.map((g) => <span data-pick-name class="text-xs rounded-full sf muted px-3 py-1">{g.name}</span>)}
          </div>
        </a>
        <GameCard game={trending[2]} postImg={postImageMap[trending[2].slug]} />
        <GameCard game={trending[3]} postImg={postImageMap[trending[3].slug]} />
        <a href="/mobile/" data-collection="mobile" class="collection-card group block fade">
          <div class="relative aspect-video rounded-2xl overflow-hidden flex ring-1 ring-black/5 dark:ring-white/10">
            {mobileSet.map((g) => (
              <div class="flex-1 relative overflow-hidden">
                <img src={gameArt(g, postImageMap[g.slug])} alt={g.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              </div>
            ))}
            <span class="absolute left-2 top-2 text-xs bg-white/90 text-slate-700 rounded-full px-3 py-1 font-medium">Danh sách game</span>
          </div>
          <h3 class="mt-3 text-xl font-extrabold">Game Mobile đang được chơi nhiều</h3>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {mobileSet.map((g) => <span data-pick-name class="text-xs rounded-full sf muted px-3 py-1">{g.name}</span>)}
          </div>
        </a>
      </div>
    </section>

    <!-- ============ GAME MOBILE ============ -->
    <section class="content-panel home-section">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-title">Game Mobile</h2>
        <a href="/mobile/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        {mobileGames.slice(0, 6).map((g) => <GameCard game={g} postImg={postImageMap[g.slug]} />)}
      </div>
    </section>

    <!-- ============ GAME PC / CONSOLE ============ -->
    <section class="content-panel home-section">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-title">Game PC / Console</h2>
        <a href="/pc/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        {pcGames.slice(0, 6).map((g) => <GameCard game={g} postImg={postImageMap[g.slug]} />)}
      </div>
    </section>

    <!-- ============ CẬP NHẬT MỚI ============ -->
    {latestPosts.length > 0 && (
      <section class="content-panel home-section">
        <div class="flex items-center justify-between mb-4">
          <h2 class="section-title">Cập nhật mới</h2>
          <a href="/cap-nhat/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-4">
          {latestPosts.map((p) => <NewsRow post={p} game={gameBySlug[p.gameSlug]} postImg={postImageMap[p.gameSlug]} />)}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  #hero[hidden], #hero [hidden] { display: none; }
  .hero-viewport { touch-action: pan-y; }
</style>

<script src="../scripts/home-games.ts"></script>
