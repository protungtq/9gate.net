---
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import games from '../../data/games.json';
import { latestPostImageMap } from '../../lib/gameArt';
import { featuredGroups, POST_PAGE_SIZE } from '../../lib/tags';

export async function getStaticPaths() {
  const pageSize = POST_PAGE_SIZE;
  const entries = await getCollection('posts');
  const posts = entries
    .map(({ id, data }) => ({
      slug: id.replace(/\.(md|mdx)$/i, ''),
      title: data.title ?? 'Bài viết',
      image: data.image ?? '',
      tag: data.tags?.[0] || 'Bài viết',
      tags: data.tags ?? [],
      dateText: data.date ? new Date(data.date).toLocaleDateString('vi-VN', {
        day: '2-digit', month: '2-digit', year: 'numeric',
      }) : '',
      _ts: data.date ? new Date(data.date).getTime() : 0,
      gameSlug: data.game || '',
    }))
    .sort((a, b) => b._ts - a._ts || a.slug.localeCompare(b.slug));

  const postImageMap = latestPostImageMap(posts);
  const postsByTag = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const label of post.tags) {
      const key = label.toLowerCase().normalize();
      const group = postsByTag.get(key) ?? { label, posts: [] };
      if (group.posts.at(-1) !== post) group.posts.push(post);
      postsByTag.set(key, group);
    }
  }

  const usedSlugs = new Set<string>();
  const filters = [{ label: 'Tất cả', path: '', posts }];
  for (const [key, group] of postsByTag) {
    const base = key.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || 'chu-de';
    let slug = base;
    for (let suffix = 2; usedSlugs.has(slug); suffix++) slug = `${base}-${suffix}`;
    usedSlugs.add(slug);
    filters.push({ label: group.label, path: `chu-de/${slug}`, posts: group.posts });
  }

  const pagePath = (filterPath: string, number: number) =>
    [filterPath, number > 1 ? String(number) : ''].filter(Boolean).join('/');
  const pageHref = (filterPath: string, number: number) => {
    const path = pagePath(filterPath, number);
    return path ? `/cap-nhat/${encodeURI(path)}/` : '/cap-nhat/';
  };
  const tags = filters.map(({ label, path }) => ({ label, path, href: pageHref(path, 1) }));

  // Thanh chip chỉ hiện tag nổi bật (top 20 theo số bài); các trang lọc chu-de vẫn giữ nguyên.
  const featuredTags = [
    { label: 'Tất cả', path: '', href: '/cap-nhat/' },
    ...featuredGroups(
      filters.slice(1).map(({ label, path, posts: fp }) => ({ label, path, href: pageHref(path, 1), posts: fp })),
    ).map(({ label, path, href }) => ({ label, path, href })),
  ];

  return filters.flatMap(({ label, path, posts: filteredPosts }) => {
    const totalPages = Math.max(1, Math.ceil(filteredPosts.length / pageSize));
    return Array.from({ length: totalPages }, (_, index) => {
      const currentPage = index + 1;
      return {
        params: { page: pagePath(path, currentPage) || undefined },
        props: {
          posts: filteredPosts.slice(index * pageSize, currentPage * pageSize),
          postImageMap,
          tags: featuredTags,
          activeTag: path,
          tagLabel: label,
          currentPage,
          totalPages,
          previousHref: currentPage > 1 ? pageHref(path, currentPage - 1) : undefined,
          nextHref: currentPage < totalPages ? pageHref(path, currentPage + 1) : undefined,
        },
      };
    });
  });
}

const gameBySlug = Object.fromEntries(games.map((game) => [game.slug, game]));
const { posts, postImageMap, tags, activeTag, tagLabel, currentPage, totalPages, previousHref, nextHref } = Astro.props;
const title = activeTag ? `Bài viết về ${tagLabel}` : 'Tin game, hướng dẫn và cập nhật';
const description = activeTag
  ? `Bài viết, hướng dẫn và cập nhật về ${tagLabel} trên 9Gate.`
  : 'Tin tức, hướng dẫn, bản cập nhật và sự kiện về game mobile, PC và console trên 9Gate.';
---

<Layout
  title={currentPage > 1 ? `${title} · Trang ${currentPage}` : title}
  description={currentPage > 1 ? `Trang ${currentPage}. ${description}` : description}
  robots={activeTag ? 'noindex, follow' : undefined}
  keywords="blog game, bài viết về game, góc nhìn game"
>
  <div class="py-6">
    <section class="content-panel" aria-labelledby="updates-heading">
      <h1 id="updates-heading" class="text-3xl sm:text-4xl font-extrabold">{title}</h1>
      <p class="muted mt-1">Bản vá, hướng dẫn và sự kiện mới nhất từ các game</p>

      {tags.length > 1 && (
        <nav id="post-topics" class="relative flex gap-2 overflow-x-auto p-1 pb-2 mt-4 mb-4" aria-label="Chủ đề bài viết">
          {tags.map(({ label, path, href }) => (
            <a
              class:list={['chip shrink-0', { 'chip-on': path === activeTag }]}
              aria-current={path === activeTag ? 'true' : undefined}
              href={href}
              draggable="false"
            >{label}</a>
          ))}
        </nav>
      )}

      {posts.length > 0 ? (
        <div class="grid lg:grid-cols-2 gap-x-4" id="post-grid">
          {posts.map((post) => <NewsRow post={post} game={gameBySlug[post.gameSlug]} postImg={postImageMap[post.gameSlug]} />)}
        </div>
      ) : (
        <div class="sf rounded-2xl p-12 text-center">
          <p class="muted">Mình chưa có bài nào ở đây.</p>
        </div>
      )}

      <Pagination label="Phân trang bài viết" {...{ currentPage, totalPages, previousHref, nextHref }} />
    </section>
  </div>
</Layout>

<style>
  #post-topics {
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--gate-accent) / 0.45) transparent;
  }

  @media (any-pointer: fine) {
    #post-topics,
    #post-topics a {
      cursor: grab;
    }

    #post-topics[data-dragging],
    #post-topics[data-dragging] a {
      cursor: grabbing;
      user-select: none;
    }
  }
</style>

<script>
  const topics = document.getElementById('post-topics');

  if (topics) {
    const active = topics.querySelector<HTMLElement>('[aria-current="true"]');
    if (active) {
      topics.scrollLeft = Math.max(0, active.offsetLeft + active.offsetWidth + 4 - topics.clientWidth);
    }

    let drag: { id: number; x: number; scrollLeft: number } | undefined;

    topics.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0 || topics.scrollWidth <= topics.clientWidth) return;
      drag = { id: event.pointerId, x: event.clientX, scrollLeft: topics.scrollLeft };
    });

    topics.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      const distance = event.clientX - drag.x;

      if (!topics.hasPointerCapture(drag.id)) {
        if (Math.abs(distance) < 6) return;
        // Keep the drag on the strip so releasing it does not open a topic link.
        topics.setPointerCapture(drag.id);
        topics.setAttribute('data-dragging', '');
      }

      topics.scrollLeft = drag.scrollLeft - distance;
    });

    const endDrag = (event: PointerEvent) => {
      if (drag?.id !== event.pointerId) return;
      drag = undefined;
      topics.removeAttribute('data-dragging');
    };

    topics.addEventListener('pointerup', endDrag);
    topics.addEventListener('pointercancel', endDrag);
    topics.addEventListener('lostpointercapture', endDrag);
    topics.addEventListener('pointerleave', (event) => {
      if (!topics.hasPointerCapture(event.pointerId)) endDrag(event);
    });
  }
</script>
