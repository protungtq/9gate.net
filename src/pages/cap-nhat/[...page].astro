---
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../../data/games.json';
import { latestPostImageMap } from '../../lib/gameArt';

export async function getStaticPaths() {
  const pageSize = 12;
  const entries = await getCollection('posts');
  const posts = entries
    .map(({ id, data }) => ({
      slug: id.replace(/\.(md|mdx)$/i, ''),
      title: data.title ?? 'Bài viết',
      image: data.image ?? '',
      tag: data.tags?.[0] || 'Bài viết',
      tags: data.tags ?? [],
      dateText: data.date ? new Date(data.date).toLocaleDateString('vi-VN', {
        day: '2-digit', month: '2-digit', year: 'numeric',
      }) : '',
      _ts: data.date ? new Date(data.date).getTime() : 0,
      gameSlug: data.game || '',
    }))
    .sort((a, b) => b._ts - a._ts || a.slug.localeCompare(b.slug));

  const postImageMap = latestPostImageMap(posts);
  const postsByTag = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const label of post.tags) {
      const key = label.toLowerCase().normalize();
      const group = postsByTag.get(key) ?? { label, posts: [] };
      if (group.posts.at(-1) !== post) group.posts.push(post);
      postsByTag.set(key, group);
    }
  }

  const usedSlugs = new Set<string>();
  const filters = [{ label: 'Tất cả', path: '', posts }];
  for (const [key, group] of postsByTag) {
    const base = key.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || 'chu-de';
    let slug = base;
    for (let suffix = 2; usedSlugs.has(slug); suffix++) slug = `${base}-${suffix}`;
    usedSlugs.add(slug);
    filters.push({ label: group.label, path: `chu-de/${slug}`, posts: group.posts });
  }

  const pagePath = (filterPath: string, number: number) =>
    [filterPath, number > 1 ? String(number) : ''].filter(Boolean).join('/');
  const pageHref = (filterPath: string, number: number) => {
    const path = pagePath(filterPath, number);
    return path ? `/cap-nhat/${encodeURI(path)}/` : '/cap-nhat/';
  };
  const tags = filters.map(({ label, path }) => ({ label, path, href: pageHref(path, 1) }));

  return filters.flatMap(({ label, path, posts: filteredPosts }) => {
    const totalPages = Math.max(1, Math.ceil(filteredPosts.length / pageSize));
    return Array.from({ length: totalPages }, (_, index) => {
      const currentPage = index + 1;
      return {
        params: { page: pagePath(path, currentPage) || undefined },
        props: {
          posts: filteredPosts.slice(index * pageSize, currentPage * pageSize),
          postImageMap,
          tags,
          activeTag: path,
          tagLabel: label,
          currentPage,
          totalPages,
          previousHref: currentPage > 1 ? pageHref(path, currentPage - 1) : undefined,
          nextHref: currentPage < totalPages ? pageHref(path, currentPage + 1) : undefined,
        },
      };
    });
  });
}

const gameBySlug = Object.fromEntries(games.map((game) => [game.slug, game]));
const { posts, postImageMap, tags, activeTag, tagLabel, currentPage, totalPages, previousHref, nextHref } = Astro.props;
const title = activeTag ? `Bài viết về ${tagLabel}` : 'Bài viết';
---

<Layout
  title={currentPage > 1 ? `${title} · Trang ${currentPage}` : title}
  description="Những ghi chép và góc nhìn của mình về game mobile, PC, console và cộng đồng người chơi."
  keywords="blog game, bài viết về game, góc nhìn game"
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">
    <h1 class="text-3xl sm:text-4xl font-extrabold">Bài viết</h1>
    <p class="muted mt-1">Bản vá, hướng dẫn và sự kiện mới nhất từ các game</p>

    {tags.length > 1 && (
      <nav class="hs flex gap-2 mt-5 mb-6" aria-label="Chủ đề bài viết">
        {tags.map(({ label, path, href }) => (
          <a class:list={['chip', { 'chip-on': path === activeTag }]} aria-current={path === activeTag ? 'true' : undefined} href={href}>{label}</a>
        ))}
      </nav>
    )}

    {posts.length > 0 ? (
      <div class="grid lg:grid-cols-2 gap-4" id="post-grid">
        {posts.map((post) => <NewsRow post={post} game={gameBySlug[post.gameSlug]} postImg={postImageMap[post.gameSlug]} />)}
      </div>
    ) : (
      <div class="sf rounded-2xl p-12 text-center">
        <p class="muted">Mình chưa có bài nào ở đây.</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-8 flex flex-wrap items-center justify-center gap-3" aria-label="Phân trang bài viết">
        {previousHref && <a class="chip min-h-11" href={previousHref} rel="prev">← Trang trước</a>}
        <span class="muted text-sm font-medium">Trang {currentPage} / {totalPages}</span>
        {nextHref && <a class="chip min-h-11" href={nextHref} rel="next">Trang sau →</a>}
      </nav>
    )}
  </div>
</Layout>
